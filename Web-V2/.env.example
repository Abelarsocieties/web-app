# Abelar PHP API base URL (no trailing slash). See https://abelar-africa.docs.buildwithfern.com/abelar/
PUBLIC_ABELAR_API_URL=https://your-api.example.com

# Optional: static bearer if your API requires Authorization on every route (including login)
ABELAR_API_KEY=

# Comma-separated emails that should receive admin/editor routes in this app
ABELAR_ADMIN_EMAILS=
